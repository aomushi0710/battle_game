## 様々な場面で使用されるenumを定義しています
class_name Enums extends RefCounted

enum Status {
	ATK, 
	DEF, 
	MAG, 
	RES, 
}

enum Target { ## 効果の発動対象
	なし, ## 効果を発動しません。
	近接, ## 場に出ている目の前の敵に発動できます。
	遠隔, ## 場に出ていない遠くの敵にも発動できます。
	敵全体, ## 敵全体に発動できます。
	自分, ## 自分に発動できます。
	味方単体, ## 味方を1体だけ選んで発動できます。
	味方全体, ## 味方全体に発動できます。
	敵味方全体, ##　敵全体と味方全体に発動できます。
}
