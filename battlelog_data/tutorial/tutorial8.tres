[resource]
script = ExtResource("1_70sor")
text = Array[String](["[b]分類[/b]: 技が参照するステータスの種類。
[color=red]物理[/color]は[color=red]ATK[/color]と[color=light_blue]DEF[/color]を、[color=dodger_blue]魔法[/color]は[color=dodger_blue]MAG[/color]と[color=purple]RES[/color]を
それぞれ参照してダメージを計算する！", "[b]対象[/b]: 技の届く効果範囲。
敵単体だけでなく敵全体を攻撃したり、
味方単体に効果を与えることもある。", "[color=aqua][b]MP Cost[/b][/color]:技の発動に必要な[color=aqua]MP[/color]の量。
強い技であればあるほど、大量の[color=aqua]MP[/color]を
要求されやすい。技の選択は慎重に！", "[color=red][b]Power[/b][/color]:技で与えるダメージの強さ。
大きいほど高いダメージになるが、
ステータスが低いとその限りではない。"])
should_wait = true
