; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="バトルゲーム"
run/main_scene="res://メインシーン.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="uid://cioi83ubpqfrg"

[autoload]

Global="*res://Global.gd"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor]

export/convert_text_resources_to_binary=false

[gui]

theme/custom_font="uid://b7nq4crdd7bl0"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/ssao/half_size=false
environment/ssil/half_size=false
environment/defaults/default_clear_color=Color(0.301961, 0.596078, 0.301961, 1)
